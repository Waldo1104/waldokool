  <!-- ==================== TOUR DETAILS MODAL POPUP ==================== -->
  <div id="tour-detail-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm hidden opacity-0 transition-opacity duration-300">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-3xl max-h-[90vh] overflow-hidden flex flex-col shadow-2xl relative">
      <!-- Modal Header -->
      <div class="p-6 border-b border-slate-800 flex items-start justify-between bg-slate-950/60">
        <div>
          <span id="modal-category" class="text-xs uppercase font-bold text-cyan-400 tracking-wider">Chi Tiết Chương Trình</span>
          <h3 id="modal-title" class="text-xl sm:text-2xl font-extrabold text-white mt-1">Tên Tour</h3>
          <p id="modal-subtitle" class="text-xs sm:text-sm text-slate-400 mt-1">Thông tin chi tiết hành trình & biểu phí</p>
        </div>
        <button onclick="closeTourModal()" class="w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div id="modal-content" class="p-6 overflow-y-auto space-y-6 text-slate-300 text-sm leading-relaxed">
        <!-- Injected via JS -->
      </div>

      <!-- Modal Footer -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/80 flex items-center justify-between gap-4">
        <div id="modal-price" class="text-lg font-black text-white font-mono">
          <!-- Price Injected -->
        </div>
        <div class="flex items-center gap-3">
          <button onclick="closeTourModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white transition">
            Đóng
          </button>
          <button id="modal-book-btn" class="px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 shadow-lg shadow-cyan-500/25 transition flex items-center gap-1.5">
            <i data-lucide="calendar-check" class="w-4 h-4"></i> Giữ Chỗ Tour Này
          </button>
        </div>
      </div>
    </div>
  </div>


  <!-- ==================== 4. CORE FEATURES (BENTO GRID) ==================== -->
  <section id="tinh-nang" class="py-24 relative">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/50 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
          <i data-lucide="cpu" class="w-3.5 h-3.5"></i>
          Đột Phá Công Nghệ AI
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
          Bộ Ba Tính Năng Độc Quyền Xóa Bỏ Điểm Nghẽn Vận Hành
        </h2>
        <p class="text-slate-400 text-base leading-relaxed">
          Tối ưu hóa từng điểm chạm trong hành trình khách hàng: từ lúc hỏi giá lúc nửa đêm đến khi lệnh điều phối được đẩy thẳng đến đối tác địa phương.
        </p>
      </div>

      <!-- 3 Feature Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Card 1: RAG Engine -->
        <div class="group p-8 rounded-2xl bg-slate-800/50 border border-slate-700/60 hover:border-cyan-500/50 transition-all duration-300 flex flex-col justify-between glow-card">
          <div>
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform">
              <i data-lucide="database" class="w-6 h-6"></i>
            </div>
            <div class="text-xs font-mono text-cyan-400 font-semibold tracking-wide uppercase mb-2">RAG Engine Chuyên Sâu</div>
            <h3 class="text-xl font-bold text-white mb-3 leading-snug">Học Sâu Kho Dữ Liệu Riêng Biệt (Zero Hallucination)</h3>
            <p class="text-slate-300 text-sm leading-relaxed mb-6">
              Đọc hiểu và liên kết toàn bộ tài liệu PDF chính sách tour, Excel bảng giá mùa vụ và quy định phụ thu. AI chỉ trả lời đúng dữ liệu đã kiểm duyệt, tuyệt đối không bịa thông tin.
            </p>
          </div>
