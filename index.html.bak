    <div class="max-w-[1000px] mx-auto px-4 sm:px-6 lg:px-8 relative">
      
      <div class="p-8 sm:p-14 rounded-3xl bg-gradient-to-br from-blue-900/40 via-slate-900 to-indigo-950/40 border border-blue-500/30 shadow-2xl relative overflow-hidden text-center">
        
