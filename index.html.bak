<!DOCTYPE html>
<html lang="vi" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nền Tảng AI Agentic & Điều Phối Đặt Chỗ Tự Động | Du Lịch & Dịch Vụ</title>
  <meta name="description" content="Tối ưu hóa tỷ lệ chuyển đổi, loại bỏ 60% lead rơi rớt ngoài giờ với Trợ lý AI chuyên sâu RAG và Bộ điều phối đặt chỗ tự động 24/7.">

  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Tailwind Custom Config -->
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            background: {
              primary: '#0F172A',
              secondary: '#1E293B',
              tertiary: '#334155',
            },
            accent: {
              electric: '#2563EB',
              indigo: '#4F46E5',
              cyan: '#06B6D4',
            },
            status: {
              success: '#10B981',
              warning: '#F59E0B',
              danger: '#EF4444',
            }
          },
          animation: {
            'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'float': 'float 4s ease-in-out infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0px)' },
              '50%': { transform: 'translateY(-6px)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Glow & Scrollbar Styles */
    ::selection {
      background-color: #2563EB;
      color: #FFFFFF;
    }
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0F172A;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #475569;
    }
    .text-gradient {
      background: linear-gradient(135deg, #38BDF8 0%, #2563EB 50%, #818CF8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .glow-border {
      box-shadow: 0 0 25px -5px rgba(37, 99, 235, 0.25);
    }
    .glow-card:hover {
      box-shadow: 0 10px 30px -10px rgba(6, 182, 212, 0.25), 0 0 0 1px rgba(6, 182, 212, 0.35);
    }
    .typing-cursor::after {
      content: '|';
      animation: blink 1s infinite;
      color: #06B6D4;
    }
    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
  </style>
</head>

<body class="bg-[#0F172A] text-slate-100 font-sans antialiased selection:bg-blue-600 selection:text-white relative overflow-x-hidden">

  <!-- Ambient Light Effect -->
  <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-blue-600/15 via-indigo-600/10 to-transparent blur-[140px] pointer-events-none -z-10"></div>

  <!-- ==================== 1. NAVIGATION BAR ==================== -->
  <header class="sticky top-0 z-50 w-full border-b border-slate-800/80 bg-[#0F172A]/80 backdrop-blur-xl transition-all duration-300">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Logo -->
      <a href="#" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-500 to-cyan-400 p-[1.5px] shadow-lg shadow-blue-500/20 group-hover:shadow-cyan-500/30 transition-all">
          <div class="w-full h-full bg-slate-900 rounded-[10px] flex items-center justify-center">
            <i data-lucide="sparkles" class="w-5 h-5 text-cyan-400"></i>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-lg font-extrabold tracking-tight text-white flex items-center gap-1">
            TourFlow <span class="text-cyan-400 font-mono text-xs px-1.5 py-0.5 rounded bg-cyan-950 border border-cyan-800/50">AI 2.0</span>
          </span>
          <span class="text-[10px] text-slate-400 font-medium tracking-wider uppercase">Agentic Booking Engine</span>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden md:flex items-center gap-8">
        <a href="#tour-noi-bat" class="text-sm font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>Tour Trọng Điểm</a>
        <a href="#thanh-toan-lien-he" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Thanh toán & Liên hệ</a>
        <a href="#tinh-nang" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Tính năng lõi</a>
        <a href="#so-sanh" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Hiệu quả</a>
        <a href="#bang-gia" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Bảng giá</a>
        <a href="#faqs" class="text-sm font-medium text-slate-300 hover:text-cyan-400 transition-colors">Giải đáp</a>
      </nav>

      <!-- CTA Button Group Desktop -->
      <div class="hidden md:flex items-center gap-4">
        <a href="admin.html" class="inline-flex items-center gap-1 text-xs font-semibold text-cyan-400 hover:text-white px-3 py-2 transition-colors border border-cyan-500/30 rounded-lg hover:bg-cyan-500/10"><i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Admin Portal</a>
        <a href="#dang-ky" class="relative group inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-white transition-all duration-300 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-lg hover:from-blue-500 hover:to-indigo-500 shadow-md shadow-blue-600/30 hover:shadow-blue-600/50 hover:-translate-y-0.5">
          <span>Dùng thử 14 ngày</span>
          <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-1.5 group-hover:translate-x-1 transition-transform"></i>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 focus:outline-none" aria-label="Toggle Menu">
        <i data-lucide="menu" id="menu-icon" class="w-6 h-6"></i>
      </button>
    </div>

    <!-- Mobile Dropdown Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-900/95 backdrop-blur-2xl px-6 py-6 transition-all">
      <div class="flex flex-col gap-4">
        <a href="#tinh-nang" class="text-base font-medium text-slate-200 hover:text-cyan-400 mobile-nav-link">Tính năng lõi</a>
        <a href="#so-sanh" class="text-base font-medium text-slate-200 hover:text-cyan-400 mobile-nav-link">Hiệu quả</a>
        <a href="#bang-gia" class="text-base font-medium text-slate-200 hover:text-cyan-400 mobile-nav-link">Bảng giá</a>
        <a href="#tour-noi-bat" class="text-base font-medium text-cyan-400 mobile-nav-link">Tour Trọng Điểm</a>
        <a href="#thanh-toan-lien-he" class="text-base font-medium text-slate-200 hover:text-cyan-400 mobile-nav-link">Thanh toán & Liên hệ</a>
        <a href="#faqs" class="text-base font-medium text-slate-200 hover:text-cyan-400 mobile-nav-link">Giải đáp</a>
        <a href="admin.html" class="text-base font-medium text-cyan-400 hover:text-white mobile-nav-link flex items-center gap-1.5"><i data-lucide="shield" class="w-4 h-4"></i> Trang Quản Trị (Admin Portal)</a>
        <div class="pt-4 border-t border-slate-800 flex flex-col gap-3">
          <a href="#dang-ky" class="w-full text-center py-3 text-sm font-bold text-white bg-blue-600 rounded-lg hover:bg-blue-500 shadow-lg shadow-blue-600/30 mobile-nav-link">Dùng thử 14 ngày miễn phí</a>
        </div>
      </div>
    </div>
  </header>

  <!-- ==================== 2. HERO SECTION ==================== -->
  <section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Column: Copywriting & CTAs (55% ~ 7 cols) -->
        <div class="lg:col-span-7 flex flex-col items-start text-left">
          
          <!-- Badge -->
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/30 backdrop-blur-md mb-6 hover:border-blue-400/50 transition-all">
            <span class="relative flex h-2.5 w-2.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-semibold text-slate-200 tracking-wide">
              Công nghệ AI Agentic 2026 — Sẵn sàng phục vụ
            </span>
          </div>

          <!-- Headline H1 -->
          <h1 class="text-3xl sm:text-4xl lg:text-[52px] font-extrabold text-white leading-[1.15] tracking-tight mb-6">
            Nhân đôi doanh số tour và phòng: <br>
            <span class="text-gradient">Phản hồi tức thì 24/7, không bỏ lỡ khách.</span>
          </h1>

          <!-- Sub-headline H2 -->
          <p class="text-base sm:text-lg text-slate-300/90 leading-relaxed max-w-2xl mb-8">
            Tạm biệt cảnh mất 60% khách hàng tiềm năng ngoài giờ hành chính. Nền tảng tự động học bảng giá, tư vấn lịch trình chuẩn xác trong 0.8 giây và điều phối đơn giữ chỗ trực tiếp tới đối tác vận hành.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-10">
            <a href="#dang-ky" class="flex items-center justify-center gap-2 px-7 py-3.5 text-sm font-bold text-white bg-gradient-to-r from-blue-600 via-indigo-600 to-blue-700 rounded-xl shadow-xl shadow-blue-600/35 hover:shadow-blue-600/55 hover:-translate-y-0.5 active:translate-y-0 transition-all">
              <span>Trải nghiệm thử AI miễn phí</span>
              <i data-lucide="zap" class="w-4 h-4 fill-white"></i>
            </a>
            <a href="#interactive-demo" class="flex items-center justify-center gap-2.5 px-6 py-3.5 text-sm font-semibold text-slate-200 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/80 rounded-xl transition-all">
              <i data-lucide="play-circle" class="w-4 h-4 text-cyan-400"></i>
              <span>Xem video mô phỏng (2p)</span>
            </a>
          </div>

          <!-- Micro Proof Banner -->
          <div class="grid grid-cols-3 gap-6 pt-8 border-t border-slate-800/80 w-full max-w-lg">
            <div>
              <div class="text-2xl lg:text-3xl font-extrabold text-white font-mono tracking-tight">&lt; 0.8s</div>
              <div class="text-xs text-slate-400 mt-1 font-medium">Tốc độ phản hồi</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-extrabold text-white font-mono tracking-tight">85%</div>
              <div class="text-xs text-slate-400 mt-1 font-medium">Tự động hóa tác vụ</div>
            </div>
            <div>
              <div class="text-2xl lg:text-3xl font-extrabold text-cyan-400 font-mono tracking-tight">+3.2x</div>
              <div class="text-xs text-slate-400 mt-1 font-medium">Tăng chuyển đổi Lead</div>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Chat Preview (45% ~ 5 cols) -->
        <div id="interactive-demo" class="lg:col-span-5 relative">
          
          <!-- Outer Decorative Glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500/20 via-blue-600/30 to-indigo-600/20 rounded-2xl blur-xl opacity-75"></div>

          <!-- Mac/Browser Mockup Card -->
          <div class="relative rounded-2xl border border-slate-700/70 bg-slate-900/90 backdrop-blur-xl shadow-2xl overflow-hidden">
            
            <!-- Window Control Header -->
            <div class="flex items-center justify-between px-4 py-3 bg-slate-950/70 border-b border-slate-800">
              <div class="flex items-center gap-2">
                <div class="w-3 h-3 rounded-full bg-rose-500/90"></div>
                <div class="w-3 h-3 rounded-full bg-amber-500/90"></div>
                <div class="w-3 h-3 rounded-full bg-emerald-500/90"></div>
              </div>
              <div class="flex items-center gap-1.5 text-xs text-slate-400 font-mono">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-cyan-400"></i>
                <span>agent-travel-dispatcher.v2</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-[11px] text-emerald-400 font-mono">Active</span>
              </div>
            </div>

            <!-- Chat Content Container -->
            <div class="p-4 sm:p-5 flex flex-col gap-4 text-xs sm:text-sm min-h-[440px] justify-between">
              
              <div class="flex flex-col gap-3.5">
                
                <!-- Message 1: Visitor / User -->
                <div class="flex justify-end items-start gap-2.5">
                  <div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-blue-600 px-4 py-3 text-white shadow-md">
                    <p class="leading-relaxed">
                      Tôi muốn tìm tour trọn gói Đà Nẵng 3 ngày 2 đêm cho 4 người lớn, ngân sách tầm 4 triệu/người, có xe đưa đón sân bay.
                    </p>
                    <div class="text-[10px] text-blue-200 mt-1 text-right font-mono">22:45 (Ngoài giờ)</div>
                  </div>
                  <div class="w-7 h-7 rounded-full bg-slate-700 flex items-center justify-center shrink-0 text-slate-300 font-bold text-xs">
                    KH
                  </div>
                </div>

                <!-- Message 2: System Processing Indicator -->
                <div id="ai-processing-status" class="flex items-center gap-2 text-cyan-400 py-1 px-3 bg-cyan-950/40 border border-cyan-800/40 rounded-lg w-fit text-xs font-mono">
                  <i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i>
                  <span>Đang tra cứu kho dữ liệu 1.000 tour & check slot trống...</span>
                </div>

                <!-- Message 3: AI Assistant Reply -->
                <div id="ai-reply-card" class="flex items-start gap-2.5 transition-all duration-500">
                  <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-400 to-blue-600 p-[1.5px] shrink-0 mt-0.5">
                    <div class="w-full h-full bg-slate-900 rounded-[10px] flex items-center justify-center">
                      <i data-lucide="bot" class="w-4 h-4 text-cyan-300"></i>
                    </div>
                  </div>
                  <div class="flex-1 rounded-2xl rounded-tl-sm bg-slate-800/90 border border-slate-700/80 p-4 text-slate-200 shadow-md">
                    <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-700/60">
                      <span class="font-bold text-white text-xs sm:text-sm flex items-center gap-1.5">
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
                        Tour Đà Nẵng - Hội An - Bà Nà Hills (3N2Đ)
                      </span>
                      <span class="text-[11px] font-mono bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded border border-emerald-500/20">Khớp 99%</span>
                    </div>

                    <div id="typewriter-text" class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-3">
                      <!-- Dynamic text injected via script -->
                    </div>

                    <!-- Booking Dispatch Action Preview -->
                    <div id="booking-actions" class="mt-3 pt-3 border-t border-slate-700/60 flex flex-col gap-2 opacity-0 transition-opacity duration-500">
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-400">Đơn vị vận hành:</span>
                        <span class="font-semibold text-slate-200">Saigon Heritage Travel</span>
                      </div>
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-400">Giá trọn gói 4 khách:</span>
                        <span class="font-bold text-emerald-400 font-mono text-sm">15.400.000 VNĐ</span>
                      </div>
                      <button onclick="simulateBookingSuccess(this)" class="mt-2 w-full py-2.5 px-3 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-xs rounded-lg flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 transition-all">
                        <i data-lucide="calendar-check" class="w-4 h-4"></i>
                        <span>Xác nhận giữ 4 chỗ ngay (Giữ trong 15p)</span>
                      </button>
                    </div>

                  </div>
                </div>

              </div>

              <!-- Input Simulator Bar -->
              <div class="pt-3 border-t border-slate-800 flex items-center gap-2">
                <div class="flex-1 bg-slate-950/80 rounded-xl px-3.5 py-2.5 text-xs text-slate-400 border border-slate-800 flex items-center justify-between">
                  <span>Nhập câu hỏi hoặc yêu cầu thêm dịch vụ...</span>
                  <i data-lucide="mic" class="w-3.5 h-3.5 text-slate-500"></i>
                </div>
                <button class="w-9 h-9 rounded-xl bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center shrink-0 transition-colors">
                  <i data-lucide="send" class="w-4 h-4"></i>
                </button>
              </div>

            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 3. SOCIAL PROOF & METRICS ==================== -->
  <section class="py-16 border-y border-slate-800/80 bg-slate-900/40 relative">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Headline & Logos -->
      <div class="text-center mb-12">
        <p class="text-xs uppercase tracking-widest font-semibold text-slate-400 mb-6">
          Được tin dùng bởi hơn 120+ nhà điều hành tour, chuỗi khách sạn và đơn vị du lịch
        </p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14 opacity-75 grayscale hover:grayscale-0 transition-all">
          <div class="flex items-center gap-2 font-bold text-base md:text-lg text-slate-300">
            <i data-lucide="compass" class="w-5 h-5 text-cyan-400"></i> Saigon Heritage
          </div>
          <div class="flex items-center gap-2 font-bold text-base md:text-lg text-slate-300">
            <i data-lucide="palmtree" class="w-5 h-5 text-emerald-400"></i> Paradise Bay Resorts
          </div>
          <div class="flex items-center gap-2 font-bold text-base md:text-lg text-slate-300">
            <i data-lucide="ship" class="w-5 h-5 text-blue-400"></i> Mekong Discovery
          </div>
          <div class="flex items-center gap-2 font-bold text-base md:text-lg text-slate-300">
            <i data-lucide="hotel" class="w-5 h-5 text-indigo-400"></i> Emerald Boutique
          </div>
          <div class="flex items-center gap-2 font-bold text-base md:text-lg text-slate-300">
            <i data-lucide="globe-2" class="w-5 h-5 text-amber-400"></i> GoAsia Travel OTA
          </div>
        </div>
      </div>

      <!-- Metrics Grid (4 Blocks) -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 pt-10 border-t border-slate-800">
        
        <div class="p-6 rounded-2xl bg-slate-800/30 border border-slate-800 flex flex-col items-center text-center">
          <span class="text-3xl sm:text-4xl font-extrabold text-white font-mono mb-1">1.500.000+</span>
          <span class="text-xs sm:text-sm font-medium text-slate-400">Lượt chat xử lý tự động / tháng</span>
        </div>

        <div class="p-6 rounded-2xl bg-slate-800/30 border border-slate-800 flex flex-col items-center text-center">
          <span class="text-3xl sm:text-4xl font-extrabold text-cyan-400 font-mono mb-1">-65%</span>
          <span class="text-xs sm:text-sm font-medium text-slate-400">Chi phí nhân sự trực ca đêm</span>
        </div>

        <div class="p-6 rounded-2xl bg-slate-800/30 border border-slate-800 flex flex-col items-center text-center">
          <span class="text-3xl sm:text-4xl font-extrabold text-emerald-400 font-mono mb-1">98.4%</span>
          <span class="text-xs sm:text-sm font-medium text-slate-400">Độ chuẩn xác bảng giá & phòng</span>
        </div>

        <div class="p-6 rounded-2xl bg-slate-800/30 border border-slate-800 flex flex-col items-center text-center">
          <span class="text-3xl sm:text-4xl font-extrabold text-indigo-400 font-mono mb-1">&lt; 48 Giờ</span>
          <span class="text-xs sm:text-sm font-medium text-slate-400">Thời gian triển khai & huấn luyện</span>
        </div>

      </div>

    </div>
  </section>

    <!-- ==================== TOURS & DESTINATIONS SHOWCASE ==================== -->
  <section id="tour-noi-bat" class="py-24 relative bg-slate-900/50 border-t border-slate-800/80">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 mb-4">
          <i data-lucide="compass" class="w-3.5 h-3.5"></i>
