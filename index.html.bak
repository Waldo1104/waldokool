  <!-- Tooltip Pill (Shows after 3s) -->
  <div id="fab-tooltip" class="fixed bottom-24 right-6 z-50 bg-slate-900 border border-cyan-500/40 text-slate-200 text-xs px-3.5 py-2 rounded-xl shadow-xl flex items-center gap-2 transform translate-y-4 opacity-0 pointer-events-none transition-all duration-500">
    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
    <span>Hỏi AI bất kỳ điều gì về tour & phòng...</span>
    <button onclick="closeTooltip(event)" class="text-slate-400 hover:text-white ml-1">✕</button>
  </div>

  <!-- Floating Action Button (FAB) -->
  <button id="fab-chat-btn" onclick="toggleChatPopup()" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-gradient-to-tr from-blue-600 via-indigo-600 to-cyan-500 text-white flex items-center justify-center shadow-2xl shadow-blue-600/50 hover:scale-105 active:scale-95 transition-all">
    <i data-lucide="message-square" id="fab-icon-open" class="w-6 h-6"></i>
    <i data-lucide="x" id="fab-icon-close" class="w-6 h-6 hidden"></i>
  </button>

  <!-- Floating Chat Popup Modal -->
  <div id="chat-popup" class="fixed bottom-24 right-6 z-50 w-[360px] sm:w-[400px] h-[520px] bg-slate-900 border border-slate-700/80 rounded-2xl shadow-2xl flex flex-col overflow-hidden hidden transform origin-bottom-right transition-all">
    
    <!-- Header -->
    <div class="px-4 py-3.5 bg-slate-950 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
          <i data-lucide="sparkles" class="w-4 h-4"></i>
        </div>
        <div>
          <div class="text-xs font-bold text-white flex items-center gap-1.5">
            TourFlow Live Assistant
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          </div>
          <div class="text-[10px] text-slate-400 font-mono">Trực tuyến 24/7 • Sẵn sàng hỗ trợ</div>
        </div>
      </div>
      <button onclick="toggleChatPopup()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="minus" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- Message Body -->
    <div id="popup-messages" class="flex-1 p-4 overflow-y-auto space-y-3 text-xs">
      <div class="flex items-start gap-2">
        <div class="w-6 h-6 rounded-full bg-blue-600 flex items-center justify-center text-white shrink-0 mt-0.5">
          <i data-lucide="bot" class="w-3.5 h-3.5"></i>
        </div>
        <div class="bg-slate-800 rounded-2xl rounded-tl-sm p-3 text-slate-200 border border-slate-700/60 max-w-[85%] leading-relaxed">
          Xin chào! Em là Trợ lý AI của TourFlow. Anh/Chị đang quan tâm đến giải pháp tích hợp chatbot hay cần gợi ý lịch trình tour cụ thể ạ?
        </div>
      </div>
    </div>

    <!-- Quick Prompts -->
    <div class="px-3 py-2 bg-slate-950/60 border-t border-slate-800 flex gap-2 overflow-x-auto text-[11px] no-scrollbar">
      <button onclick="sendQuickMessage('Cho tôi xem bảng giá chi tiết')" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
        💰 Bảng giá chi tiết
      </button>
      <button onclick="sendQuickMessage('Cách tích hợp vào Zalo OA')" class="whitespace-nowrap px-2.5 py-1 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700">
        ⚡ Tích hợp Zalo OA
      </button>
    </div>

    <!-- Input Box -->
    <form onsubmit="handlePopupSend(event)" class="p-3 bg-slate-950 border-t border-slate-800 flex items-center gap-2">
      <input id="popup-input" type="text" placeholder="Nhập câu hỏi của bạn..." class="flex-1 bg-slate-900 border border-slate-700 px-3 py-2 text-xs text-white rounded-lg focus:outline-none focus:border-cyan-400">
      <button type="submit" class="p-2 bg-blue-600 hover:bg-blue-500 text-white rounded-lg">
        <i data-lucide="send" class="w-3.5 h-3.5"></i>
      </button>
    </form>

  </div>

  <!-- ==================== JAVASCRIPT CONTROLLERS ==================== -->
  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // Mobile Hamburger Menu Toggle
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });

    // Typewriter Animation in Hero Split-Screen Simulator
    const aiText = "Dạ chào anh, em đã kiểm tra kho tour: Gợi ý tối ưu nhất là Tour Đà Nẵng 3N2Đ ở tại Grand Sea Hotel 4 sao ven biển (bao gồm buffet sáng và xe riêng đưa đón 2 chiều sân bay).";
    const typewriterEl = document.getElementById('typewriter-text');
    const actionsEl = document.getElementById('booking-actions');
    const processingEl = document.getElementById('ai-processing-status');
    let charIndex = 0;

    function typeWriter() {
      if (charIndex < aiText.length) {
        typewriterEl.textContent += aiText.charAt(charIndex);
        typewriterEl.classList.add('typing-cursor');
        charIndex++;
        setTimeout(typeWriter, 22);
      } else {
        typewriterEl.classList.remove('typing-cursor');
        actionsEl.classList.remove('opacity-0');
        actionsEl.classList.add('opacity-100');
        processingEl.innerHTML = `<i data-lucide="check" class="w-3.5 h-3.5 text-emerald-400"></i><span class="text-emerald-400 font-semibold">Đã đồng bộ xong dữ liệu (0.78s)</span>`;
        lucide.createIcons();
      }
    }

    // Trigger Typewriter after 800ms
    window.addEventListener('DOMContentLoaded', () => {
      setTimeout(typeWriter, 800);
    });

    // Simulate Booking Click in Hero
    function simulateBookingSuccess(btn) {
      btn.innerHTML = `<i data-lucide="check-circle" class="w-4 h-4"></i><span>Đã gửi lệnh giữ chỗ tới Saigon Heritage Travel!</span>`;
      btn.classList.remove('from-emerald-600', 'to-teal-600');
      btn.classList.add('bg-blue-600');
      btn.disabled = true;
      lucide.createIcons();
    }

    // FAQ Accordion Toggle
    function toggleFaq(btn) {
      const content = btn.nextElementSibling;
      const icon = btn.querySelector('[data-lucide="chevron-down"]');
      const isHidden = content.classList.contains('hidden');

      // Close other FAQs
      document.querySelectorAll('.faq-content').forEach(c => c.classList.add('hidden'));
      document.querySelectorAll('#faqs [data-lucide="chevron-down"]').forEach(i => i.classList.remove('rotate-180'));

      if (isHidden) {
        content.classList.remove('hidden');
        if (icon) icon.classList.add('rotate-180');
      }
    }

    // Floating Action Button (FAB) Tooltip Timer (3 seconds)
    setTimeout(() => {
      const tooltip = document.getElementById('fab-tooltip');
      if (tooltip) {
        tooltip.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      }
    }, 3000);

    function closeTooltip(e) {
      e.stopPropagation();
      const tooltip = document.getElementById('fab-tooltip');
      tooltip.classList.add('opacity-0', 'pointer-events-none');
    }

    // Floating Chat Popup Toggle
    function toggleChatPopup() {
      const popup = document.getElementById('chat-popup');
      const openIcon = document.getElementById('fab-icon-open');
      const closeIcon = document.getElementById('fab-icon-close');
      const tooltip = document.getElementById('fab-tooltip');

      if (tooltip) tooltip.classList.add('opacity-0', 'pointer-events-none');

      popup.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    }

    // Popup Chat Interaction
    function handlePopupSend(e) {
      e.preventDefault();
      const input = document.getElementById('popup-input');
      const text = input.value.trim();
      if (!text) return;

      appendChatMessage(text, 'user');
      input.value = '';

      // AI Simulated Reply
      setTimeout(() => {
        appendChatMessage("Cảm ơn anh/chị! Chuyên viên giải pháp AI sẽ liên hệ hỗ trợ tích hợp thử nghiệm qua email/Zalo của anh/chị ngay nhé.", 'bot');
      }, 700);
    }

    function sendQuickMessage(text) {
      appendChatMessage(text, 'user');
      setTimeout(() => {
        if (text.includes('Bảng giá')) {
          appendChatMessage("Gói Professional hiện đang được ưu đãi chỉ từ 4.990.000đ/tháng với đầy đủ RAG không giới hạn và kết nối Zalo OA ạ!", 'bot');
        } else {
          appendChatMessage("Việc tích hợp Zalo OA chỉ mất 2 phút thông qua Webhook được cấp sẵn trong Dashboard quản trị anh/chị nhé.", 'bot');
        }
      }, 600);
    }

    function appendChatMessage(text, sender) {
      const container = document.getElementById('popup-messages');
      const msgDiv = document.createElement('div');

      if (sender === 'user') {
        msgDiv.className = 'flex justify-end';
        msgDiv.innerHTML = `<div class="bg-blue-600 text-white rounded-2xl rounded-tr-sm p-3 max-w-[85%]">${text}</div>`;
      } else {
        msgDiv.className = 'flex items-start gap-2';
        msgDiv.innerHTML = `
          <div class="w-6 h-6 rounded-full bg-blue-600 flex items-center justify-center text-white shrink-0 mt-0.5">
            <i data-lucide="bot" class="w-3.5 h-3.5"></i>
          </div>
          <div class="bg-slate-800 rounded-2xl rounded-tl-sm p-3 text-slate-200 border border-slate-700/60 max-w-[85%] leading-relaxed">${text}</div>
        `;
      }

      container.appendChild(msgDiv);
      container.scrollTop = container.scrollHeight;
      lucide.createIcons();
    }

    // Handle Sign-Up Form Submit
    function handleFormSubmit(e) {
      e.preventDefault();
      alert("Chúc mừng! Đăng ký dùng thử 14 ngày của bạn đã được ghi nhận. Đội ngũ kỹ thuật sẽ gửi thông tin truy cập hệ thống qua email trong 5 phút tới.");
    }

    // Lắng nghe sự kiện chuyển đổi Booking từ ai-chat-widget.js để đo lường GA4 / Meta Pixel
    window.addEventListener('bookingDispatched', (event) => {
      console.log('🎉 [Conversion Triggered] Booking Order Dispatched:', event.detail);
      // Gợi ý đo lường:
      // if (typeof gtag === 'function') { gtag('event', 'purchase', event.detail); }
      // if (typeof fbq === 'function') { fbq('track', 'Purchase', { value: event.detail.total_estimated_price, currency: 'VND' }); }
    });
  </script>

  <!-- Module AI Chatbot & Booking Dispatcher Độc Lập -->
  <script src="ai-chat-widget.js"></script>

  <script>
    // Tour Data Store for Modal & Booking
    const TOURS_STORE = {
      korea: {
